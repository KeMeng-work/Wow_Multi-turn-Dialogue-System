# .env文件的示例

# ==================== 主 LLM（填你自己的 Qwen-plus-api-key）====================
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==================== Langfuse 监控（填写自己项目的langfuse publickey和secretkey）====================
LANGFUSE_NEXTAUTH_SECRET=your_nextauth_secret_here
LANGFUSE_SALT=your_salt_here
LANGFUSE_DB_PASSWORD=langfuse          # Langfuse 内部数据库密码，可自定义
CLICKHOUSE_PASSWORD=clickhouse         # ClickHouse 密码，v3 必需

# 以下两个 key：docker-compose up 启动后登录 :3000 → 创建 Project → Settings → 获取项目专属API Keys
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Langfuse端口
LANGFUSE_HOST=http://localhost:3000

# ==================== Redis（填写自己的redis密码） ====================
REDIS_PASSWORD=your_redis_password

# ==================== Neo4j（填写自己的neo4j密码） ====================
NEO4J_PASSWORD=your_neo4j_password

# ==================== PostgreSQL（填写自己的postgresql密码） ====================
# CLI 直接运行时需填写实际地址（服务器 localhost 或 127.0.0.1）
PG_HOST=localhost
PG_PORT=5432
PG_DB=conversation_db
PG_USER=your_pg_user
PG_PASSWORD=your_pg_password

# ==================== Milvus（填写自己的milvus地址和项目集合名） ====================
# Docker 内由 docker-compose environment 覆盖为 milvus-standalone
# CLI 直接运行时填写实际地址
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=wow_knowledge_base_v2

# ==================== vLLM（独立脚本src\scripts\路径下查看）====================
# CLI 直接运行时默认 localhost，Docker 内由 docker-compose 覆盖为 host.docker.internal
# VLLM_REWRITE_URL=http://localhost:8001/v1
# VLLM_EXTRACT_URL=http://localhost:8002/v1

# ==================== TEI 重排器（bge-reranker-v2-m3，GPU FP16）====================
# Docker 内默认自动连接 tei-reranker 容器，无需手动填写
# TEI_RERANKER_URL=http://tei-reranker:80/rerank
# RERANKER_TIMEOUT=30
# RERANKER_MAX_LENGTH=1024
# RERANKER_MAX_CLIENT_BATCH_SIZE=128   # 须 ≤ docker-compose 中 TEI 的 --max-client-batch-size

# ==================== 检索参数（修改后重建 app 容器即可生效，无需重新构建镜像）====================
# VECTOR_TOP_K=30                  # 向量召回单句数
# BM25_TOP_K=30                    # BM25 召回单句数
# RRF_K=60
# RRF_FINAL_TOP_K=25               # 段落级 RRF 后送重排的父段落数
# RETRIEVAL_TAU_HIGH=0.5           # 置信档下限：最高分 ≥ 它时正常返回
# RETRIEVAL_TAU_LOW=0.1            # 拒答线：最高分 < 它时直接返回固定话术
# RETRIEVAL_ALPHA=0.5              # 置信档相对阈值：score ≥ alpha × 最高分
# RETRIEVAL_AMBIGUOUS_MAX=3        # 低置信档送判定器的块数上限
# RETRIEVAL_ENFORCE_REFUSAL=true   # false = 影子模式（只记录"本应拒答"，照常返回）
# RETRIEVAL_THRESHOLD_VERSION=bge-reranker-v2-m3_fp16_tei_2026-10   # 阈值标定所依据的模型版本
# RETRIEVAL_MAX_K_SIMPLE=5
# RETRIEVAL_MAX_K_REASONING=5
# RETRIEVAL_MAX_K_MULTI_HOP=3      # 多跳单次检索上限
# RETRIEVAL_MULTIHOP_BUDGET=12     # 多跳整题不同段落总预算
# RETRIEVAL_TRACE_TOP_N=10         # RETRIEVAL_TRACE 日志 / Langfuse 记录的候选段落数

# ==================== 充分性判定器（低置信档）====================
# EVALUATOR_MODE=ambiguous         # off / ambiguous / all
# EVALUATOR_BASE_URL=http://host.docker.internal:8001/v1   # 默认复用 qwen3-4b
# EVALUATOR_MODEL=qwen3-4b
# EVALUATOR_TIMEOUT=3              # 秒；超时按降级处理（保留文档并标记）
# EVALUATOR_MAX_TOKENS=32
# EVALUATOR_PASSAGE_CHARS=1500

# ==================== 回答后处理 ====================
# REFUSAL_TEXT=知识库中没有找到与这个问题相关的资料，暂时无法回答。可以换个问法，或补充更具体的人名、作品名等信息后再试。
# LOW_EVIDENCE_NOTICE=（说明：以上回答所依据的知识库资料与问题的相关性较低，仅供参考。）
# BACKGROUND_LLM_CONCURRENCY=2     # 后台记忆任务并发上限

# ==================== 在线搜索（百度千帆）====================
QIANFAN_API_KEY=your_qianfan_api_key_here
# 可选开关，默认开启
# WEB_SEARCH_ENABLED=true

# ==================== 模型路径（按照以下路径放入模型文件即可）====================
# {PROJECT_ROOT}/src/models/nomic_embed_model_int8 需自行onnx-int8量化
# {PROJECT_ROOT}/src/models/translate_model_int8  需自行onnx-int8量化
# {PROJECT_ROOT}/src/models/bge-reranker-v2-m3   FP16原版，由 tei-reranker 容器加载（TEI自动处理GPU FP16推理）
# {PROJECT_ROOT}/src/models/qwen3-8B-AWQ  官方AWQ int8量化版本
# {PROJECT_ROOT}/src/models/qwen3-1.7B   官方原版




# ==================== MCP 服务（docker-compose 的 mcp 服务）====================
# 客户端访问令牌（至少 16 位，生成：openssl rand -hex 24）；Claude Code 等客户端请求头 Authorization: Bearer <令牌>
MCP_ACCESS_TOKEN=
# mcp 访问 app 的服务账号（先执行：docker compose exec app python scripts/create_user.py create mcp-service）
MCP_SERVICE_USERNAME=mcp-service
MCP_SERVICE_PASSWORD=
