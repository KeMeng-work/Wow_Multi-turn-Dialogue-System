wow:ActivityDisjointShape a sh:NodeShape ;
    sh:message "Activity 与其他互斥类同时出现"@zh ;
    sh:not [ sh:or ( [ sh:class wow:CreativeWork ] [ sh:class wow:Event ] [ sh:class wow:Field ] [ sh:class wow:FoodAndDrink ] [ sh:class wow:Genre ] [ sh:class wow:Organism ] [ sh:class wow:Organization ] [ sh:class wow:Person ] [ sh:class wow:Place ] [ sh:class wow:Product ] ) ] ;
    sh:targetClass wow:Activity .

wow:CreativeWorkDisjointShape a sh:NodeShape ;
    sh:message "CreativeWork 与其他互斥类同时出现"@zh ;
