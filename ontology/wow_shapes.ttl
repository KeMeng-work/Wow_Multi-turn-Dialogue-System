    sh:targetClass wow:CreativeWork .

wow:EntityShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path wow:name ],
        [ sh:in ( "kb" "gloss" ) ;
            sh:maxCount 1 ;
            sh:path wow:descriptionSource ] ;
    sh:targetClass wow:Entity .

